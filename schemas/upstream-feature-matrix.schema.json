{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIALRA-KIMI upstream feature matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["upstreamVersion", "source", "statuses", "features"],
  "properties": {
    "upstreamVersion": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "format": "uri" },
    "statuses": {
      "type": "object",
      "required": ["native", "secured", "substituted"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string" },
        "secured": { "type": "string" },
        "substituted": { "type": "string" }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "operations", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["native", "secured", "substituted"] },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence": { "type": "string", "minLength": 1 },
          "securityRationale": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
