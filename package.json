{
  "name": "aialra-kimi",
  "version": "0.1.0",
  "private": true,
  "description": "A self-hosted, multi-host control plane for Kimi Code",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24.15.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1",
      "ws": "8.21.3"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm -r --if-present check && pnpm test",
    "dev": "pnpm --parallel --filter @aialra-kimi/control-plane --filter @aialra-kimi/web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "playwright test",
    "docs:screenshots": "playwright test --config playwright.readme.config.ts",
    "verify:sri": "node scripts/add-sri.mjs apps/web/dist --verify",
    "check:rust": "cargo fmt --manifest-path crates/agent/Cargo.toml --check && cargo clippy --manifest-path crates/agent/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path crates/agent/Cargo.toml",
    "check:upstream": "pnpm --filter @aialra-kimi/control-plane check:upstream",
    "refresh:upstream": "node scripts/refresh-upstream-lock.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  }
}
