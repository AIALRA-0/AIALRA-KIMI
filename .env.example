NODE_ENV=production
HOST=127.0.0.1
PORT=8787
PUBLIC_ORIGIN=https://kimi.example.com
DATABASE_PATH=/var/lib/aialra-kimi/control-plane.sqlite
DATABASE_KEY_FILE=/run/credentials/aialra-kimi-control-plane.service/database_key
SESSION_KEY_FILE=/run/credentials/aialra-kimi-control-plane.service/session_key
GRANT_SIGNING_PRIVATE_KEY_FILE=/run/credentials/aialra-kimi-control-plane.service/grant_signing_key
OIDC_ISSUER=https://auth.example.com/application/o/aialra-kimi/
OIDC_CLIENT_ID=replace-with-main-client-id
OIDC_CLIENT_SECRET_FILE=/run/credentials/aialra-kimi-control-plane.service/oidc_client_secret
OIDC_REDIRECT_URI=https://kimi.example.com/auth/callback
OIDC_OWNER_GROUP=aialra-kimi-owner
OIDC_ELEVATION_ISSUER=https://auth.example.com/application/o/aialra-kimi-elevation/
OIDC_ELEVATION_CLIENT_ID=replace-with-elevation-client-id
OIDC_ELEVATION_CLIENT_SECRET_FILE=/run/credentials/aialra-kimi-control-plane.service/elevation_oidc_client_secret
OIDC_ELEVATION_REDIRECT_URI=https://kimi.example.com/auth/elevate/callback
WEB_DIST_PATH=/opt/aialra-kimi/current/web
TRUST_PROXY=1
DEV_AUTH_BYPASS=0
